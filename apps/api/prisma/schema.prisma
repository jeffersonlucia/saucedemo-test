generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  inactive
}

enum UnitStatus {
  active
  inactive
}

enum UserStatus {
  active
  inactive
}

enum MembershipRole {
  platform_admin
  owner
  manager
  staff
  member
}

enum MemberStatus {
  lead
  active
  paused
  past_due
  cancelled
  invited
}

enum BillingPeriod {
  monthly
  quarterly
  annual
}

enum PlanStatus {
  active
  inactive
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  past_due
}

enum EventStatus {
  draft
  published
  cancelled
  completed
}

enum EventVisibility {
  members_only
  restricted
  public
}

enum ReservationStatus {
  confirmed
  waitlisted
  cancelled
  checked_in
  no_show
}

enum InventoryMovementType {
  in
  out
  adjustment
}

model Tenant {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  slug        String                @unique
  status      TenantStatus          @default(active)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  units       Unit[]
  brandConfig TenantBrandConfig?
  flags       TenantFeatureFlag[]
  memberships TenantMembership[]
  members     Member[]
  tags        MemberTag[]
  plans       Plan[]
  benefits    PlanBenefit[]
  events      Event[]
  reservations Reservation[]
  checkins    Checkin[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model Unit {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  name            String
  status          UnitStatus    @default(active)
  timezone        String        @default("America/Sao_Paulo")
  addressJson     Json?         @map("address_json")
  defaultCapacity Int?          @map("default_capacity")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  memberships     TenantMembership[]
  members         Member[]      @relation("MemberPrimaryUnit")
  events          Event[]

  @@index([tenantId, status])
  @@map("units")
}

model TenantBrandConfig {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  displayName    String   @map("display_name")
  logoUrl        String?  @map("logo_url")
  primaryColor   String   @map("primary_color")
  secondaryColor String   @map("secondary_color")
  accentColor    String   @map("accent_color")
  fontFamily     String?  @map("font_family")
  welcomeText    String?  @map("welcome_text")
  linksJson      Json?    @map("links_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_brand_configs")
}

model TenantFeatureFlag {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  unitId     String?  @map("unit_id") @db.Uuid
  key        String
  enabled    Boolean  @default(false)
  configJson Json?    @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, unitId, key])
  @@index([tenantId, key])
  @@map("tenant_feature_flags")
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  email          String             @unique
  passwordHash   String             @map("password_hash")
  name           String
  phone          String?
  status         UserStatus         @default(active)
  lastLoginAt    DateTime?          @map("last_login_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  memberships    TenantMembership[]
  refreshTokens  RefreshToken[]
  memberProfiles Member[]
  checkins       Checkin[]          @relation("CheckinStaff")
  auditLogs      AuditLog[]         @relation("AuditActor")

  @@map("users")
}

model TenantMembership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  unitId    String?        @map("unit_id") @db.Uuid
  role      MembershipRole
  status    UserStatus     @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  unit      Unit?          @relation(fields: [unitId], references: [id])

  @@unique([tenantId, userId, role, unitId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
  @@map("refresh_tokens")
}

model Member {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  primaryUnitId  String?         @map("primary_unit_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  fullName       String          @map("full_name")
  email          String?
  phone          String?
  document       String?
  birthDate      DateTime?       @map("birth_date") @db.Date
  status         MemberStatus    @default(lead)
  preferencesJson Json?          @map("preferences_json")
  internalNotes  String?         @map("internal_notes")
  marketingOptIn Boolean         @default(false) @map("marketing_opt_in")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  primaryUnit    Unit?           @relation("MemberPrimaryUnit", fields: [primaryUnitId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  tagAssignments MemberTagAssignment[]
  subscriptions  Subscription[]
  reservations   Reservation[]
  checkins       Checkin[]

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("members")
}

model MemberTag {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  name        String
  color       String?
  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  assignments MemberTagAssignment[]

  @@unique([tenantId, name])
  @@map("member_tags")
}

model MemberTagAssignment {
  tenantId String    @map("tenant_id") @db.Uuid
  memberId String    @map("member_id") @db.Uuid
  tagId    String    @map("tag_id") @db.Uuid
  member   Member    @relation(fields: [memberId], references: [id])
  tag      MemberTag @relation(fields: [tagId], references: [id])

  @@id([tenantId, memberId, tagId])
  @@map("member_tag_assignments")
}

model Plan {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  name          String
  description   String?
  priceCents    Int             @map("price_cents")
  billingPeriod BillingPeriod   @map("billing_period")
  status        PlanStatus      @default(active)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  benefits      PlanBenefit[]
  subscriptions Subscription[]
  allowedEvents EventAllowedPlan[]

  @@index([tenantId, status])
  @@map("plans")
}

model PlanBenefit {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  type        String
  title       String
  description String?
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  plan        Plan     @relation(fields: [planId], references: [id])

  @@index([tenantId, planId])
  @@map("plan_benefits")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  memberId           String             @map("member_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(active)
  startedAt          DateTime           @map("started_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  member             Member             @relation(fields: [memberId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([tenantId, memberId, status])
  @@map("subscriptions")
}

model Event {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  unitId        String             @map("unit_id") @db.Uuid
  title         String
  description   String?
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  capacity      Int
  status        EventStatus        @default(draft)
  visibility    EventVisibility    @default(members_only)
  priceCents    Int                @default(0) @map("price_cents")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  unit          Unit               @relation(fields: [unitId], references: [id])
  allowedPlans  EventAllowedPlan[]
  reservations  Reservation[]
  checkins      Checkin[]

  @@index([tenantId, unitId, startsAt])
  @@map("events")
}

model EventAllowedPlan {
  tenantId String @map("tenant_id") @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid
  event    Event  @relation(fields: [eventId], references: [id])
  plan     Plan   @relation(fields: [planId], references: [id])

  @@id([tenantId, eventId, planId])
  @@map("event_allowed_plans")
}

model Reservation {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventId       String            @map("event_id") @db.Uuid
  memberId      String            @map("member_id") @db.Uuid
  status        ReservationStatus @default(confirmed)
  guestCount    Int               @default(0) @map("guest_count")
  qrTokenHash   String            @map("qr_token_hash")
  reservedAt    DateTime          @default(now()) @map("reserved_at")
  cancelledAt   DateTime?         @map("cancelled_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  event         Event             @relation(fields: [eventId], references: [id])
  member        Member            @relation(fields: [memberId], references: [id])
  checkin       Checkin?

  @@unique([tenantId, eventId, memberId])
  @@index([tenantId, eventId, status])
  @@index([tenantId, memberId, status])
  @@map("reservations")
}

model Checkin {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  eventId           String      @map("event_id") @db.Uuid
  reservationId     String      @unique @map("reservation_id") @db.Uuid
  memberId          String      @map("member_id") @db.Uuid
  checkedInByUserId String      @map("checked_in_by_user_id") @db.Uuid
  checkedInAt       DateTime    @default(now()) @map("checked_in_at")
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  event             Event       @relation(fields: [eventId], references: [id])
  reservation       Reservation @relation(fields: [reservationId], references: [id])
  member            Member      @relation(fields: [memberId], references: [id])
  checkedInBy       User        @relation("CheckinStaff", fields: [checkedInByUserId], references: [id])

  @@index([tenantId, eventId])
  @@map("checkins")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
